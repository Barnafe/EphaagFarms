# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=4000

# PostgreSQL connection.
# Local dev: the default below (a local Postgres you're running yourself).
# Production (Neon): paste the connection string from your Neon project
# dashboard → Connection Details → "Pooled connection". It already
# includes ?sslmode=require — leave that in.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ephaag_farms

# Set to "true" for Neon or any hosted Postgres that requires SSL. Leave
# unset/false for a local Postgres with no SSL configured.
DB_SSL=false

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — the frontend's origin(s), comma-separated if more than one.
# Only matters when the frontend is hosted separately from this API; the
# production Render setup serves both from one origin so this is mainly
# used for the password-reset email link there. In local dev, this is
# the Vite dev server URL.
FRONTEND_ORIGIN=http://localhost:5173

# Required to register a new Admin account through the public Register
# page (Account type: Admin). Change this to something private — anyone
# who knows it can create an admin account with full internal access.
ADMIN_SETUP_CODE=change-this-to-something-private

# Email (Investor module: agreement emails, congratulations, payment
# reminders). Without these, emails are composed and logged but never
# actually sent — safe for local dev. For real delivery, use a Gmail App
# Password (not your normal Gmail password) or a transactional service
# like SendGrid/Mailgun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL="EPHAAG Farms <your-email@gmail.com>"
