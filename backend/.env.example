# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=4000

# PostgreSQL connection.
# Local dev: the default below (a local Postgres you're running yourself).
# Production (Neon): paste the connection string from your Neon project
# dashboard → Connection Details → "Pooled connection". It already
# includes ?sslmode=require — leave that in.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ephaag_farms

# Set to "true" for Neon or any hosted Postgres that requires SSL. Leave
# unset/false for a local Postgres with no SSL configured.
DB_SSL=false

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — the frontend's origin(s), comma-separated if more than one.
# Only matters when the frontend is hosted separately from this API; the
# production Render setup serves both from one origin so this is mainly
# used for the password-reset email link there. In local dev, this is
# the Vite dev server URL.
FRONTEND_ORIGIN=http://localhost:5173

# Required to register a new Admin account through the public Register
# page (Account type: Admin). Change this to something private — anyone
# who knows it can create an admin account with full internal access.
ADMIN_SETUP_CODE=change-this-to-something-private

# Email (Investor module: agreement emails, congratulations, payment
# reminders). Without these, emails are composed and logged but never
# actually sent — safe for local dev. For real delivery, use a Gmail App
# Password (not your normal Gmail password) or a transactional service
# like SendGrid/Mailgun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL="EPHAAG Farms <your-email@gmail.com>"

# --- Farmer share payments -------------------------------------------------
# With PAYSTACK_SECRET_KEY set, share purchases go through Paystack (NGN) and
# are only fulfilled after the system verifies the transaction with Paystack.
# The fee is added to the farmer's total (editable in Finance > Payment confirmations > Settings).
# PAYMENT_ALLOW_SIMULATED=true gives a clearly-labelled SIMULATED payment for LOCAL TESTING ONLY:
# it is off unless you set it, and it is ignored when NODE_ENV=production.
PAYSTACK_SECRET_KEY=
# PAYMENT_ALLOW_SIMULATED=true
# Farmers with no email are sent to Paystack under a placeholder address on a domain you control:
# FARMER_PLACEHOLDER_EMAIL_DOMAIN=farmers.ephaag.app
# DB_POOL_MAX=20

# --- Corps access-fee payments (phase 3) -----------------------------------
# The same PAYSTACK_SECRET_KEY above powers the corps access fee. With it set,
# a corps member pays on Paystack and is unlocked automatically (on return, or
# when Paystack calls the webhook). Without it, the payment waits for an admin
# to confirm it by hand in TRC -> Corps (there is NO free/simulated access).
# In the Paystack dashboard (Settings -> API Keys & Webhooks) set the webhook
# URL to:   https://<your-site>/api/corpers/paystack-webhook
# FRONTEND_ORIGIN (above) must be your real site URL: Paystack sends members
# back to <FRONTEND_ORIGIN>/dashboard/corper after paying.

# --- Corps certificates (batches, certificates, NYSC export) ----------------
# "Your certificate is ready" emails go out one by one with this pause between
# them (milliseconds). Real delivery needs the SMTP_* settings above; without
# them emails are only logged and show as "not delivered" so they can be sent
# later from TRC -> Corps -> Batches once SMTP is configured.
CERT_EMAIL_DELAY_MS=1500
# FRONTEND_ORIGIN (above) must be the real site URL: it is printed on every
# certificate and encoded in its QR code (<FRONTEND_ORIGIN>/verify-certificate/<code>).

# =============================================================================
# FOUNDATIONS (step 1 of the gap-closing plan)
# =============================================================================

# --- Permanent file storage: Cloudflare R2 (phase 15) -------------------------
# In production these are REQUIRED. Without them uploads are refused (503)
# instead of silently writing to a disk that a redeploy wipes. On a developer
# machine (NODE_ENV not production) files go to backend/uploads/ instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Public URL of the public bucket (r2.dev address or your own domain).
R2_PUBLIC_BASE_URL=
# R2_ENDPOINT=   # only for testing against a stand-in; normally derived from R2_ACCOUNT_ID

# --- Email and SMS (phase 16) -------------------------------------------------
# EMAIL_DRIVER: ses | smtp | log. Automatic: ses if SES_REGION + AWS keys are
# set, else smtp if SMTP_HOST is set, else log (nothing leaves the server and
# messages show as failed in Admin -> System -> Messages).
# EMAIL_DRIVER=ses
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# FROM_EMAIL (above) must be an address on a domain verified in SES.
EMAIL_RATE_PER_SECOND=5
# SES bounces/complaints: create an SNS topic, subscribe
#   https://<your-site>/api/messaging/ses-events
# and point the SES configuration set's bounce + complaint events at it.
# SMS (Termii-style JSON API). Needs a registered sender name.
SMS_API_KEY=
SMS_SENDER_ID=
# SMS_API_URL=https://api.ng.termii.com/api/sms/send
# SMS_CHANNEL=dnd          # "dnd" reaches numbers on the Do-Not-Disturb list
SMS_DAILY_LIMIT_PER_PERSON=5
# Named person who gets an SMS when a job or webhook fails (can also be set in Admin -> System).
ALERT_SMS_PHONE=

# --- Scheduled jobs (phase 17) ------------------------------------------------
# Always-on host: leave as is, the app runs its own timer.
# Sleeping host (e.g. Render free): set a secret, then have a free outside
# pinger (cron-job.org, UptimeRobot...) call every 5 minutes:
#   GET https://<your-site>/api/system/tick   with header  x-tick-secret: <secret>
JOB_TICK_SECRET=
# JOB_RUNNER=off           # disable the internal timer (e.g. extra web copies)

# --- Login protection (phase 18) ----------------------------------------------
# CSP_MODE=report-only     # switch to "enforce" once Admin -> System -> Security log shows no csp_violation entries
# RATE_LIMIT_MULTIPLIER=1  # only raise for load tests
# Production: FRONTEND_ORIGIN (above) is the ONLY site allowed to call the API from a browser.

# --- Paystack (step 2: phase 1 onward) ---------------------------------------
# One secret key serves orders, standing commitments and corps fees. Use the TEST key first.
# Webhook address to enter in the Paystack dashboard (Settings -> API Keys & Webhooks):
#   https://<your-site>/api/payments/paystack-webhook
# (the old corps address /api/corpers/paystack-webhook keeps working)
# A missing key means "Online payment unavailable": it never means a free order.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_BASE_URL=        # only for testing against a stand-in server
# FRONTEND_ORIGIN (above) must be your real site address: Paystack sends buyers back to
#   <FRONTEND_ORIGIN>/dashboard/buyer/payment-return
